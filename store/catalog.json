{
  "_schema": {
    "doc": "Server Core Manager 应用商店 · 数据源（手工精选，面向服务器场景：轻量、CLI 优先）。",
    "honesty_rule": "compatibility 里的 verified 表示【本项目在真机上实测通过】。没有实测证据的一律写 unverified。宁可少标，不可虚标。",
    "real_source_note": "实测（Server Core 2025 / build 26100）：winget 不存在（依赖的 App Installer MSIX 也装不上），choco 2.7.4 可用，npm/node 可用，scoop/pip 不可用。所以 install.type 以 choco 为主。",
    "download_count_note": "winget 与 choco 的命令行输出里都没有下载量字段。热度只能靠 popularity 手工标注，UI 不要写『按下载量排序』。",
    "fields": {
      "id": "唯一标识，小写连字符（必填）",
      "name": "英文名（必填）",
      "name_zh": "中文名（必填）",
      "category": "场景分类，取 categories[].id（必填）",
      "ui": "cli | tui | gui（必填）。cli/tui 在 Server Core 上本来就能跑，gui 才需要 FOD",
      "tags": "搜索辅助标签（含中文/别名）",
      "source": "manual | choco | npm | winget | local（必填）",
      "compatibility": "verified | partial | unsupported | unverified（必填）",
      "compatibility_note": "一句话说明凭据：实测数据、或『尚未实测』",
      "fod_required": "需要的 FOD 组件；ui=gui 时才可能非空",
      "runtime_deps": "运行库依赖",
      "install": "主方案 + fallback",
      "install.type": "choco | npm | winget | direct | local",
      "install.id": "上游包 ID",
      "install.id_aliases": "上游包 ID 变更时的兼容映射",
      "install.silent_args": "静默安装参数",
      "install.download_url": "direct 类型用",
      "install.fallback": "主方案不可用时的次选",
      "launch": "exe / args / env / working_dir",
      "known_issues": "已知问题列表",
      "alternatives": "替代软件 id",
      "tested_on": "实测通过的系统版本；未实测留空数组",
      "popularity": "0-100 的热度权重，手工维护（不是下载量）",
      "contributor": "贡献者署名",
      "updated": "最后更新日期"
    }
  },

