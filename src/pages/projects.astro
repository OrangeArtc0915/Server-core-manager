---
import { siteConfig } from "../config";
import { getCollection } from "astro:content";
import { UNCATEGORIZED } from "../constants/constants";
import {
	getAllTechStack,
	getFeaturedProjects,
	getProjectsByCategory,
	projectsData,
} from "../data/projects";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { loadIconify } from "../utils/icon-loader";
import { url } from "../utils/url-utils";
// 页面里有 <iconify-icon> 元素，必须自己带加载器
// （原先靠 MainGridLayout 全局那份，现在全局那份已移除，只在真正需要的页面加载）
import IconifyLoader from "../components/misc/IconifyLoader.astro";

// 检查项目页面是否启用
if (!siteConfig.featurePages.projects) {
	return Astro.redirect("/404/");
}

const { lang } = Astro.props;

// 加载Iconify图标库
loadIconify().catch((error) => {
	console.error("Failed to load Iconify:", error);
});

// 获取项目统计信息
const featuredProjects = getFeaturedProjects();
const allTechStack = getAllTechStack();

// 获取所有分类（只统计会出现在分类列表里的项目）
const categories = [
	...new Set(
		projectsData
			.filter((project) => project.showInCategory !== false)
			.map((project) => project.category),
	),
];

// 按分类获取项目
const projectsByCategory = categories.reduce(
	(acc, category) => {
		acc[category] = getProjectsByCategory(category);
		return acc;
	},
	{} as Record<string, typeof projectsData>,
);

const title = i18n(I18nKey.projects);
const subtitle = i18n(I18nKey.projectsSubtitle);

// 获取分类文本的国际化翻译
const getCategoryText = (category: string) => {
	switch (category) {
		case "scm":
			return i18n(I18nKey.projectsScm);
		case "mobile":
			return i18n(I18nKey.projectsMobile);
		case "other":
			return i18n(I18nKey.projectsOther);
		case UNCATEGORIZED:
			return i18n(I18nKey.uncategorized);
		default:
			return category;
	}
};

// 项目卡片的目标地址：站内介绍页优先，其次外部链接
const projectHref = (project: (typeof projectsData)[number]) => {
	if (project.internalPage) return url(project.internalPage);
	return project.visitUrl ?? project.sourceCode ?? "";
};
---

<MainGridLayout title={title} description={subtitle}>
  <IconifyLoader />
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题 -->
      <div class="flex flex-col items-start justify-center mb-8">
        <h1 class="text-4xl font-bold text-black/90 dark:text-white/90 mb-2 relative
                  before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)]
                  before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4">
          {i18n(I18nKey.projects)}
        </h1>
        <p class="text-lg text-black/60 dark:text-white/60">
          {i18n(I18nKey.projectsSubtitle)}
        </p>
      </div>

      <!-- 特色项目 -->
      {featuredProjects.length > 0 && (
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-black/90 dark:text-white/90 mb-4 relative
                    before:w-1 before:h-6 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4">
            {i18n(I18nKey.projectsFeatured)}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {featuredProjects.map((project) => (
              <div class="relative bg-white dark:bg-transparent rounded-lg border border-black/10 dark:border-white/10 overflow-hidden hover:shadow-lg transition-shadow duration-300">
                {project.image && (
                  <div class="aspect-video overflow-hidden">
                    <img 
                      src={project.image} 
                      alt={project.title}
                      class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                    />
                  </div>
                )}
                <div class="p-6">
                  <div class="flex items-start justify-between mb-3">
                    <h3 class="text-xl font-semibold text-black/90 dark:text-white/90">
                      <a
                        href={projectHref(project)}
                        class="hover:text-[var(--primary)] transition-colors after:absolute after:inset-0 after:content-['']"
                      >
                        {project.title}
                      </a>
                    </h3>
                    <span class={`px-2 py-1 text-xs rounded-full ${
                      project.status === 'completed' 
                        ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400'
                        : project.status === 'in-progress'
                        ? 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400'
                        : 'bg-gray-100 text-gray-700 dark:bg-gray-900/30 dark:text-gray-400'
                    }`}>
                      {i18n(project.status === 'completed' ? I18nKey.projectsCompleted : 
                            project.status === 'in-progress' ? I18nKey.projectsInProgress : 
                            I18nKey.projectsPlanned)}
                    </span>
                  </div>
                  <p class="text-black/60 dark:text-white/60 mb-4 line-clamp-2">
                    {project.description}
                  </p>
                  <div class="flex flex-wrap gap-2 mb-4">
                    {project.techStack.slice(0, 4).map((tech) => (
                      <span class="px-2 py-1 text-xs bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 rounded">
                        {tech}
                      </span>
                    ))}
                    {project.techStack.length > 4 && (
                      <span class="px-2 py-1 text-xs bg-gray-100 text-gray-700 dark:bg-gray-900/30 dark:text-gray-400 rounded">
                        +{project.techStack.length - 4}
                      </span>
                    )}
                  </div>
                  <div class="relative z-10 flex flex-wrap gap-2 text-sm">
                    {projectHref(project) && (
                      <a 
                        href={projectHref(project)} 
                        target={project.internalPage ? undefined : "_blank"}
                        rel={project.internalPage ? undefined : "noopener noreferrer"}
                        class="btn-gradient btn-gradient-primary btn-gradient-md"
                      >
                        <iconify-icon icon="material-symbols:open-in-new" width="18" height="18"></iconify-icon>
                        {i18n(I18nKey.projectsVisit)}
                      </a>
                    )}
                    {project.downloadUrl && (
                      <a 
                        href={project.downloadUrl} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="btn-gradient btn-gradient-primary btn-gradient-md"
                      >
                        <iconify-icon icon="material-symbols:download" width="18" height="18"></iconify-icon>
                        {i18n(I18nKey.projectsDownload)}
                      </a>
                    )}
                    {project.sourceCode && (
                      <a 
                        href={project.sourceCode} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="btn-gradient btn-github btn-gradient-md"
                      >
                        <iconify-icon icon="mdi:github" width="18" height="18"></iconify-icon>
                        {i18n(I18nKey.projectsGitHub)}
                      </a>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- 按分类展示项目 -->
      <div class="space-y-8">
        {categories.map((category) => {
          const categoryProjects = projectsByCategory[category];
          if (categoryProjects.length === 0) return null;
          
          return (
            <div>
              <h2 class="text-2xl font-bold text-black/90 dark:text-white/90 mb-4 relative
                        before:w-1 before:h-6 before:rounded-md before:bg-[var(--primary)]
                        before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4">
                {getCategoryText(category)}
                <span class="text-lg font-normal text-black/60 dark:text-white/60 ml-2">
                  ({categoryProjects.length})
                </span>
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {categoryProjects.map((project) => (
                  <div class="relative bg-white dark:bg-transparent rounded-lg border border-black/10 dark:border-white/10 overflow-hidden hover:shadow-lg transition-shadow duration-300">
                    {project.image && (
                      <div class="aspect-video overflow-hidden">
                        <img 
                          src={project.image} 
                          alt={project.title}
                          class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                        />
                      </div>
                    )}
                    <div class="p-4">
                      <div class="flex items-start justify-between mb-2">
                        <h3 class="text-lg font-semibold text-black/90 dark:text-white/90 line-clamp-1">
                          {projectHref(project) ? (
                            <a
                              href={projectHref(project)}
                              class="hover:text-[var(--primary)] transition-colors after:absolute after:inset-0 after:content-['']"
                            >
                              {project.title}
                            </a>
                          ) : (
                            project.title
                          )}
                        </h3>
                        <span class={`px-2 py-1 text-xs rounded-full shrink-0 ml-2 ${
                          project.status === 'completed' 
                            ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400'
                            : project.status === 'in-progress'
                            ? 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400'
                            : 'bg-gray-100 text-gray-700 dark:bg-gray-900/30 dark:text-gray-400'
                        }`}>
                          {i18n(project.status === 'completed' ? I18nKey.projectsCompleted : 
                                project.status === 'in-progress' ? I18nKey.projectsInProgress : 
                                I18nKey.projectsPlanned)}
                        </span>
                      </div>
                      <p class="text-black/60 dark:text-white/60 mb-3 text-sm line-clamp-2">
                        {project.description}
                      </p>
                      <div class="flex flex-wrap gap-1 mb-3">
                        {project.techStack.slice(0, 3).map((tech) => (
                          <span class="px-2 py-1 text-xs bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 rounded">
                            {tech}
                          </span>
                        ))}
                        {project.techStack.length > 3 && (
                          <span class="px-2 py-1 text-xs bg-gray-100 text-gray-700 dark:bg-gray-900/30 dark:text-gray-400 rounded">
                            +{project.techStack.length - 3}
                          </span>
                        )}
                      </div>
                      <div class="relative z-10 flex flex-wrap gap-2 text-sm">
                        {projectHref(project) && (
                          <a 
                            href={projectHref(project)} 
                            target={project.internalPage ? undefined : "_blank"}
                            rel={project.internalPage ? undefined : "noopener noreferrer"}
                            class="btn-gradient btn-gradient-primary btn-gradient-md"
                          >
                            <iconify-icon icon="material-symbols:open-in-new" width="18" height="18"></iconify-icon>
                            {i18n(I18nKey.projectsVisit)}
                          </a>
                        )}
                        {project.downloadUrl && (
                          <a 
                            href={project.downloadUrl} 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="btn-gradient btn-gradient-primary btn-gradient-md"
                          >
                            <iconify-icon icon="material-symbols:download" width="18" height="18"></iconify-icon>
                            {i18n(I18nKey.projectsDownload)}
                          </a>
                        )}
                        {project.sourceCode && (
                          <a 
                            href={project.sourceCode} 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="btn-gradient btn-github btn-gradient-md"
                          >
                            <iconify-icon icon="mdi:github" width="18" height="18"></iconify-icon>
                            {i18n(I18nKey.projectsGitHub)}
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <!-- 技术栈统计 -->
      <div class="mt-12 pt-8 border-t border-black/10 dark:border-white/10">
        <h2 class="text-2xl font-bold text-black/90 dark:text-white/90 mb-4">
          {i18n(I18nKey.projectsTechStack)}
        </h2>
        <div class="flex flex-wrap gap-2">
          {allTechStack.map((tech) => (
            <span class="px-3 py-1 text-sm bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300 rounded-full">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</MainGridLayout>

<style>
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>