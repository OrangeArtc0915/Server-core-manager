---
import { getCollection } from "astro:content";
import IconifyLoader from "@components/misc/IconifyLoader.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getWikiProject, wikiProjects, wikiSlug } from "@/data/wiki-projects";
import { url } from "@utils/url-utils";

export function getStaticPaths() {
	return wikiProjects.map((project) => ({
		params: { project: project.key },
		props: { project: project.key },
	}));
}

const GROUP_ORDER = ["入门", "使用", "进阶", "参考", "支持"] as const;

const GROUP_LEAD: Record<string, string> = {
	入门: "先把它装上、跑起来，再回头了解细节。",
	使用: "日常真正会用到的东西，以及起不来时怎么查。",
	进阶: "进阶配置：能改的都在这。",
	参考: "常见问题、已知限制，以及想改代码时需要知道的事。",
	支持: "免费开源，赞助完全自愿；不花钱的支持方式其实更有用。",
};

const { project: projectKey } = Astro.props;
const projectMeta = getWikiProject(projectKey);
const projectName = projectMeta?.name ?? "文档";

const entries = await getCollection("wiki");
const chapters = entries
	.filter((e) => e.data.project === projectKey)
	.map((e) => ({
		slug: wikiSlug(e.slug, e.data.project),
		title: e.data.title,
		group: e.data.group as string,
		order: e.data.order,
		description: e.data.description,
	}))
	.sort((a, b) => {
		const d = GROUP_ORDER.indexOf(a.group as never) - GROUP_ORDER.indexOf(b.group as never);
		return d !== 0 ? d : a.order - b.order;
	});
const groups = GROUP_ORDER.filter((g) => chapters.some((c) => c.group === g));
---
<MainGridLayout title={`${projectName} 文档`} description={projectMeta?.subtitle}>
  <IconifyLoader />
  <div class="card-base px-6 py-6 md:px-9 md:py-8">
    <!-- 面包屑 -->
    <nav class="mb-4 flex flex-wrap items-center gap-1 text-xs text-50" aria-label="面包屑">
      <a href={url("/wiki/")} class="link">文档</a>
      <span class="opacity-60">/</span>
      <span class="text-75">{projectName}</span>
    </nav>

    <div class="flex items-start gap-3">
      <div class="w-11 h-11 rounded-lg flex items-center justify-center shrink-0 bg-black/5 dark:bg-white/10">
        <iconify-icon icon={projectMeta?.icon ?? "material-symbols:menu-book"} width="24" height="24" style="color: var(--primary)"></iconify-icon>
      </div>
      <div class="min-w-0">
        <h1 class="text-3xl font-bold text-black/90 dark:text-white/90">{projectName}</h1>
        <p class="mt-2 max-w-3xl text-50 leading-relaxed">{projectMeta?.subtitle}</p>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap gap-2">
      <a href={url("/wiki/")} class="btn-gradient btn-gradient-primary btn-gradient-md">
        <iconify-icon icon="material-symbols:arrow-back" width="18" height="18"></iconify-icon>
        全部文档
      </a>
      {projectMeta?.repo && (
        <a href={projectMeta.repo} target="_blank" rel="noopener noreferrer" class="btn-gradient btn-github btn-gradient-md">
          <iconify-icon icon="mdi:github" width="18" height="18"></iconify-icon>
          GitHub 仓库
        </a>
      )}
    </div>

    {groups.map((g) => (
      <section class="mt-9">
        <div class="flex items-baseline gap-3">
          <h2 class="text-xl font-bold text-black/90 dark:text-white/90">{g}</h2>
          <span class="text-sm text-50">{GROUP_LEAD[g]}</span>
        </div>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {chapters.filter((c) => c.group === g).map((c) => (
            <a href={url(`/wiki/${projectKey}/${c.slug}/`)}
               class="group flex h-full flex-col rounded-[var(--radius-large)] border border-[var(--line-divider)] bg-[var(--card-bg)] px-4 py-3.5 transition hover:border-[var(--primary)]">
              <div class="font-medium text-90 transition group-hover:text-[var(--primary)]">{c.title}</div>
              {c.description && <div class="mt-1.5 text-sm leading-relaxed text-50">{c.description}</div>}
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</MainGridLayout>
