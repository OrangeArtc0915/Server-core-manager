# ============================================================
#  运行时产物：含本机/测试机的主机名、用户名、内网 IP、会话记录
#  这些一律不进仓库，否则等于把内网信息公之于众
# ============================================================
logs/
reports/
backup/
state/

# 终端美化（一键美化终端）会在工具目录下建 bin\：oh-my-posh / fastfetch / 主题 /
# scm-term.cmd 等运行时文件，不是源码（其中的 .exe 已被下面 *.exe 忽略，但 .cmd 与主题不会）。
bin/

# 签名相关：Sign-GuiReady.ps1 -CreateSelfSigned 默认会把证书写到根目录。
# 私钥绝不能进仓库 —— 这里必须挡住（清单也是构建产物，由 pack.ps1 生成进发布包）。
*.pfx
*.pvk
*.spc
*.cer
证书.*
manifest.sha256
*.sha256

# ============================================================
#  二进制与安装包
#  体积大（WindowsAdminCenter.exe 就有 133 MB），且会把仓库历史撑爆。
#  发布时作为 Releases 附件上传，不提交到 git。
# ============================================================
*.exe
*.msi
*.zip
payload/

# 终端美化素材（setup\console\ 里的 Nerd Font 字体）：字体是二进制且体积大，
# 同样不进 git，由 pack.ps1 打进发布包。
*.ttf

# ============================================================
#  未公开的资料
# ============================================================
参考.txt

# ============================================================
#  本地签名辅助工具（不进仓库）
#    signtool / makecert / certmgr 等是微软 SDK 的二进制（已被上面 *.exe 挡住），
#    krnln.fnr / shell.fne 是第三方（易语言）运行库 —— 都不是本项目源码，
#    也不该由本项目再分发。本项目签 .ps1 用的是 PowerShell 原生链路
#    （Sign-GuiReady.ps1 = New-SelfSignedCertificate + Set-AuthenticodeSignature），
#    用不到这个目录。真要随仓库发布时用 git add -f 明确加进来。
# ============================================================
签名/

# 调试时随手产生的空占位文件
debug.log

# ============================================================
#  打包输出
# ============================================================
dist/

# ============================================================
#  编辑器 / 操作系统噪音
# ============================================================
.vs/
.vscode/
.idea/
*.user
*.suo
Thumbs.db
desktop.ini

# ============================================================
#  本地工作目录（不属于程序本体，不要提交）
#    site\ —— 网站项目（Astro）。源码在 WEB 分支上，这里只是本机用来构建/预览的
#             工作树（git worktree），里面还有 node_modules，很大。
#  忽略它有两个作用：一是别让 git status 一直挂着上百个未跟踪文件；二是避免
#  哪天 git add -A 把 WEB 分支的站点内容混进 main。
# ============================================================
site/
